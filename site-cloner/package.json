{
  "name": "site-cloner",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first AI agent that clones a website's frontend into React + TypeScript and edits it from natural-language prompts. Runs on Ollama, no API keys.",
  "type": "module",
  "scripts": {
    "setup": "npm install && npx playwright install chromium",
    "doctor": "tsx src/cli.ts doctor",
    "start": "tsx src/server.ts",
    "clone": "tsx src/cli.ts clone",
    "modify": "tsx src/cli.ts modify",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 --test-force-exit tests/*.test.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "cheerio": "^1.0.0",
    "express": "^4.21.2",
    "playwright": "^1.49.1",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "tsx": "^4.19.2"
  },
  "engines": { "node": ">=18.18" }
}
